    cout << "=== LC #104 Max Depth ===\n";
    vector<int> v104 = {3, 9, 20, -1, -1, 15, 7};
    TreeNode* t104 = buildTree(v104);
    cout << "Max Depth: " << maxDepth(t104) << "\n\n";

    // --- LC #100 Same Tree ---
    // Input:  p = [1,2,3], q = [1,2,3]
    // Output: true
    cout << "=== LC #100 Same Tree ===\n";
    vector<int> vp = {1, 2, 3};
    vector<int> vq = {1, 2, 3};
    TreeNode* tp = buildTree(vp);
    TreeNode* tq = buildTree(vq);
    cout << "Same Tree (expect 1): " << isSameTree(tp, tq) << "\n";

    vector<int> vp2 = {1, 2};
    vector<int> vq2 = {1, -1, 2};
    TreeNode* tp2 = buildTree(vp2);
    TreeNode* tq2 = buildTree(vq2);
    cout << "Same Tree (expect 0): " << isSameTree(tp2, tq2) << "\n\n";

    // --- LC #572 Subtree of Another Tree ---
    // Input:  root = [3,4,5,1,2], subRoot = [4,1,2]
    // Output: true
    cout << "=== LC #572 Subtree of Another Tree ===\n";
    vector<int> vroot  = {3, 4, 5, 1, 2};
    vector<int> vsub   = {4, 1, 2};
    TreeNode* troot  = buildTree(vroot);
    TreeNode* tsub   = buildTree(vsub);
    cout << "Is Subtree (expect 1): " << isSubtree(troot, tsub) << "\n";

    vector<int> vroot2 = {3, 4, 5, 1, 2, -1, -1, -1, -1, 0};
    vector<int> vsub2  = {4, 1, 2};
    TreeNode* troot2 = buildTree(vroot2);
    TreeNode* tsub2  = buildTree(vsub2);
    cout << "Is Subtree (expect 0): " << isSubtree(troot2, tsub2) << "\n";

    return 0;
}